{
  "name": "portfolio-app",
  "version": "1.0.0",
  "description": "Full-stack portfolio application",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm start",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:watch": "concurrently \"npm run dev:backend:watch\" \"npm run dev:frontend:watch\"",
    "dev:backend:watch": "cd backend && nodemon server.js",
    "dev:frontend:watch": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "echo 'Backend build (if needed)'",
    "build:frontend": "cd frontend && npm run build",
    "start": "npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "portfolio",
    "fullstack",
    "mern"
  ],
  "author": "",
  "license": "ISC"
}
